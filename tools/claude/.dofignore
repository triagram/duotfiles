# Second gate for ~/.claude, behind the .dofkeep allow-list.
#
# The allow-list is what decides today; this list exists so that loosening the
# allow-list later cannot sweep machine-local state into the repo by accident.
# Everything here is generated by Claude Code and is meaningless on the other
# machine. Only whole-line comments are recognised, same as .gitignore.

# ── Credentials ─────────────────────────────────────────────────────────────
.credentials.json
.claude.json

# ── Conversation and session state ──────────────────────────────────────────
projects/
sessions/
session-env/
history.jsonl
file-history/
todos/
backups/
paste-cache/

# ── Runtime / daemon / cache ────────────────────────────────────────────────
daemon/
jobs/
cache/
shell-snapshots/
statsig/
debug/
state/
downloads/
chrome/
daemon.log
daemon.lock
daemon.status.json
daemon-auth-status.json
daemon-auth-cooldown
stats-cache.json
.last-cleanup
.last-update-result.json

# ── Synced from the account ─────────────────────────────────────────────────
# Claude Code's own copy of the account's skills. It carries personal
# details, and a skills/ line in .dofkeep would match this whole subtree.
skills/synced/

# ── Installed by a marketplace, reinstalled per machine ─────────────────────
plugins/
