# Second gate for ~/.claude, behind the .dofkeep allow-list.
#
# The allow-list is what decides; this list exists so that loosening the
# allow-list later cannot accidentally sweep machine-local state into the repo.
# Everything here is generated by Claude Code and is meaningless on another machine.
#
# Only whole-line comments are recognised, same as .gitignore.

# ── Credentials ─────────────────────────────────────────────────────────────
.credentials.json
.claude.json

# ── Conversation and session state ──────────────────────────────────────────
projects/
sessions/
session-env/
history.jsonl
file-history/
todos/
backups/

# ── Runtime / daemon / cache ────────────────────────────────────────────────
daemon/
jobs/
cache/
downloads/
usage-data/
statsig/
shell-snapshots/
stats-cache.json
daemon.lock
daemon.log
daemon.status.json
.last-cleanup
.last-update-result.json

# ── Marketplace plugins: reinstallable, not configuration ───────────────────
plugins/
